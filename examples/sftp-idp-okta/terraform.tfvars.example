aws_region  = "us-east-1"
name_prefix = "sftp-okta"

# Okta Configuration
okta_domain = "your-org.okta.com"

# One entry per Okta user. Each user gets their own home directory.
okta_users = [
  "sftpuser@example.com",
  # "second.user@example.com",
]

# Optional: Enable MFA
# okta_mfa_required     = true  # Only works if MFA enrollment policy and Global Session Policy is active in Okta
# okta_mfa_token_length = 6

# Optional: Use API Gateway instead of Lambda
# provision_api = true

# Optional: S3 encryption with KMS (default is AES256)
# s3_encryption_algorithm = "aws:kms"
# s3_kms_key_id           = "arn:aws:kms:us-east-1:123456789012:key/your-key-id"

# Optional: Restrict IP access for default users
# default_user_ipv4_allow_list = ["10.0.0.0/8"]
